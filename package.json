{
  "name": "family-health-agent-console",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node --env-file-if-exists=.env server/index.js",
    "dev": "vite",
    "start": "npm run server & npm run dev",
    "check": "node --env-file-if-exists=.env server/selfcheck.js",
    "gen:media": "node --experimental-strip-types scripts/generate-family-media.ts",
    "gen:icons": "node --experimental-strip-types scripts/generate-icons.ts",
    "dev:lan": "vite --host",
    "ios:build": "node scripts/ios-build.mjs",
    "ios:open": "cap open ios",
    "reset": "curl -fsS -X POST http://localhost:${PORT:-8787}/api/reset -H 'Content-Type: application/json' -d '{\"reason\":\"npm run reset\"}'"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
