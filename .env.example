# Agent brain. gemini | anthropic
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-pro
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Gnani Vachana STT/TTS. Without this, gnani_stt degrades to CURTAIN-PERSON
# and the UI says so out loud.
GNANI_API_KEY=

# Apps Script web app URL for the decision log + wallet ledger.
# Empty = log locally, header shows "Sheets: off".
SHEETS_WEBHOOK_URL=

PORT=8787
